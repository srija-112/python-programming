//Import NumPy, Pandas, SciPy and Matplotlib. Read CSV file and display first five rows.
import numpy as np
import pandas as pd
from scipy import stats
import matplotlib.pyplot as plt

df = pd.read_csv("student_performance.csv")

print(df.head())

//Find rows, columns, column names, data types and missing values.
print(df.shape)
print(df.columns)
print(df.dtypes)
print(df.isna().sum())

//Calculate mean, median, standard deviation, minimum and maximum using NumPy.
for col in ["Study_Hours_Per_Day", "Exam_Score"]:
    x = df[col].dropna().to_numpy()

    print("\n", col)
    print("Mean:", np.mean(x))
    print("Median:", np.median(x))
    print("Standard Deviation:", np.std(x, ddof=1))
    print("Minimum:", np.min(x))
    print("Maximum:", np.max(x))

//Replace missing values with median and verify.
for col in ["Attendance_Percent", "Assignment_Score"]:
    df[col] = df[col].fillna(df[col].median())

print(df.isna().sum())

//Calculate average Exam_Score for each department.
dept_average = df.groupby("Department")["Exam_Score"].mean()

print(dept_average)
print("Highest average:", dept_average.idxmax())

//Create Performance_Level and count students.
df["Performance_Level"] = np.select(
    [
        df["Exam_Score"] >= 75,
        df["Exam_Score"] >= 50
    ],
    ["High", "Moderate"],
    default="Needs Support"
)

print(df["Performance_Level"].value_counts())

//Calculate Pearson correlation coefficient and p-value.
r, p = stats.pearsonr(
    df["Study_Hours_Per_Day"],
    df["Exam_Score"]
)

print("Pearson Correlation:", r)
print("P-value:", p)

//Perform Welch's independent samples t-test.
high_attendance = df.loc[
    df["Attendance_Percent"] >= 80,
    "Exam_Score"
]

low_attendance = df.loc[
    df["Attendance_Percent"] < 80,
    "Exam_Score"
]

t, p = stats.ttest_ind(
    high_attendance,
    low_attendance,
    equal_var=False
)

print("T-statistic:", t)
print("P-value:", p)

print("High attendance mean:",
      high_attendance.mean())

print("Low attendance mean:",
      low_attendance.mean())

//Draw histogram and scatter plot.
# Histogram
plt.figure(figsize=(7, 4))

plt.hist(df["Exam_Score"],
         bins=10,
         edgecolor="black")

plt.title("Distribution of Examination Scores")
plt.xlabel("Exam Score")
plt.ylabel("Number of Students")
plt.grid(axis="y", alpha=0.3)

plt.show()

# Scatter plot
plt.figure(figsize=(7, 4))

plt.scatter(
    df["Study_Hours_Per_Day"],
    df["Exam_Score"]
)

plt.title("Study Hours vs Exam Score")
plt.xlabel("Study Hours Per Day")
plt.ylabel("Exam Score")
plt.grid(alpha=0.3)

plt.show()

